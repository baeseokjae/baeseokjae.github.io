{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.Home.Permalink }}</loc>
    <lastmod>{{ site.Lastmod.Format "2006-01-02" }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {{- with site.GetPage "section" "posts" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {{- end }}
  {{- range where site.RegularPages "Section" "" }}
  {{- if and (not .Params.robotsNoIndex) (ne .Layout "search") }}
  {{- $lastmod := .Lastmod }}
  {{- if eq ($lastmod.Format "2006-01-02") "0001-01-01" }}
  {{- $lastmod = site.Lastmod }}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ $lastmod.Format "2006-01-02" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {{- end }}
  {{- end }}
</urlset>
