{
  "inputs": [
    {
      "type": "promptString",
      "id": "sonar-token",
      "description": "SonarQube user token",
      "password": true
    },
    {
      "type": "promptString",
      "id": "sonar-url",
      "description": "SonarQube Server URL"
    }
  ],
  "servers": {
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "sonarsource/sonarqube-mcp:1.19.0.2785"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${input:sonar-token}",
        "SONARQUBE_URL": "${input:sonar-url}"
      }
    }
  }
}
